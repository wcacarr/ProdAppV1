<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Querying only launcher activities avoids QUERY_ALL_PACKAGES and its
       Play Store policy declaration. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name=".QuestlockAccessibilityService"
      android:exported="true"
      android:label="@string/questlock_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/questlock_accessibility_config" />
    </service>

    <!-- Holds notification-listener access, which is what MediaSessionManager
         requires before it will hand out active media sessions. -->
    <service
      android:name=".QuestlockNotificationListener"
      android:exported="true"
      android:label="@string/questlock_media_label"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>

</manifest>
